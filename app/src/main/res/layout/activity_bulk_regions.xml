<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        android:navigationIcon="@drawable/ic_arrow_back"
        android:title="Ajouter une liste"
        android:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Écris ou colle ta liste. Le plus simple : une région par ligne. Les listes déjà numérotées de 1 à 99 sont aussi reconnues automatiquement."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Liste des régions / niveaux"
                app:boxStrokeColor="@color/primary"
                app:helperText="Exemple : Royaume musical ↵ Royaume sucrerie ↵ Royaume de feu">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegionList"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="10"
                    android:paddingTop="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textDetectedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Aucune région détectée"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Type appliqué à toute la liste"
                android:textColor="@color/text_secondary" />

            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@color/surface"
                android:paddingHorizontal="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCreateRegions"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="26dp"
                android:text="Créer les régions"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:backgroundTint="@color/primary" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
